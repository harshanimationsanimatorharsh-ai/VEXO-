<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_editor">

    <!-- ── TOP TOOLBAR ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/bg_primary">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VEXO Editor"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Export"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="@color/vexo_purple"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- ── VIDEO PREVIEW ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="true"
            app:resize_mode="fit" />

        <!-- Colour-filter overlay — colorFilter applied here in Kotlin -->
        <ImageView
            android:id="@+id/filterOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:alpha="0.0" />
    </FrameLayout>

    <!-- ── SCROLLABLE BOTTOM PANEL ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- EDIT TOOLS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✂  Edit Tools"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/btnTrim"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Trim"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnSplit"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Split"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnSpeed"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Speed"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnVolume"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Volume"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnMute"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Mute"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnRotate"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Rotate"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnFlip"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Flip"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnDuplicate"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Duplicate"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnDelete"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Delete"
                        android:textColor="#FF6584"
                        android:background="@drawable/bg_button" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ADJUST SLIDERS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎨  Adjust"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Brightness"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderBrightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="-100"
                    android:valueTo="100"
                    android:value="0"
                    android:stepSize="1"
                    app:thumbColor="@color/vexo_purple"
                    app:trackColorActive="@color/vexo_purple"
                    app:trackColorInactive="#444444" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Contrast"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderContrast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:value="1.0"
                    android:stepSize="0.1"
                    app:thumbColor="@color/vexo_purple"
                    app:trackColorActive="@color/vexo_purple"
                    app:trackColorInactive="#444444" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Saturation"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSaturation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.0"
                    android:valueTo="2.0"
                    android:value="1.0"
                    android:stepSize="0.1"
                    app:thumbColor="@color/vexo_purple"
                    app:trackColorActive="@color/vexo_purple"
                    app:trackColorInactive="#444444" />
            </LinearLayout>

            <!-- FILTERS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨  Filters"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterButtonsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp" />
            </HorizontalScrollView>

            <!-- EFFECTS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡  Effects"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/effectButtonsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp" />
            </HorizontalScrollView>

            <!-- ANIMATIONS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎬  Animations"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/animationButtonsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp" />
            </HorizontalScrollView>

            <!-- VIDEO EFFECTS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎥  Video Effects"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/videoEffectButtonsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
