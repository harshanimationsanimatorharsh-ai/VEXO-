<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_editor"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Edit Photo"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Save"
            android:textSize="13sp"
            style="@style/VexoButton"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_editor"
        android:scaleType="fitCenter"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/bg_secondary"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <LinearLayout android:id="@+id/btnFilterNone"
                android:layout_width="64dp" android:layout_height="64dp"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="8dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnFilterBW"
                android:layout_width="64dp" android:layout_height="64dp"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="8dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B&amp;W"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnFilterWarm"
                android:layout_width="64dp" android:layout_height="64dp"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="8dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warm"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnFilterCool"
                android:layout_width="64dp" android:layout_height="64dp"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="8dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cool"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnFilterVintage"
                android:layout_width="64dp" android:layout_height="64dp"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vintage"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_secondary"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Brightness"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
            <SeekBar android:id="@+id/seekBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" android:progress="50"
                android:progressTint="@color/vexo_purple"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Saturation"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
            <SeekBar android:id="@+id/seekSaturation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" android:progress="50"
                android:progressTint="@color/vexo_purple"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:text="Reset"
            android:textSize="13sp"
            style="@style/VexoButtonOutline"/>

    </LinearLayout>

</LinearLayout>
