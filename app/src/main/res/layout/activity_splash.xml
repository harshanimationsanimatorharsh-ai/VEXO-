<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Outer Glow Ring -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal">

        <!-- Glow Background -->
        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_logo_glow"
            android:alpha="0.3"/>

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_vexo_logo"
            android:contentDescription="VEXO"/>

    </FrameLayout>

    <!-- App Name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="VEXO"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"/>

    <!-- Tagline -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Create without limits."
        android:textColor="#A855F7"
        android:textSize="16sp"
        android:letterSpacing="0.05"/>

    <!-- Divider Line -->
    <View
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_gradient"/>

    <!-- Made By -->
    <TextView
        android:id="@+id/tvMadeBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Made by Mr.Harsh"
        android:textColor="#6B6B8A"
        android:textSize="13sp"
        android:letterSpacing="0.05"/>

</LinearLayout>
