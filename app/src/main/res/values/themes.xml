<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Vexo"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vexo_purple</item>
        <item name="colorPrimaryVariant">@color/vexo_purple_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/vexo_pink</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <style name="Theme.Vexo.Dark" parent="Theme.Vexo">
        <item name="android:colorBackground">@color/bg_editor</item>
        <item name="android:statusBarColor">@color/bg_editor</item>
        <item name="android:navigationBarColor">@color/bg_editor</item>
        <item name="android:windowBackground">@color/bg_editor</item>
    </style>

    <style name="VexoButton"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/vexo_purple</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VexoButtonOutline"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/vexo_purple</item>
        <item name="android:textColor">@color/vexo_purple</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
